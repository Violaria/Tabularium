{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"],
    "importHelpers": false,
    "inlineSourceMap": false,
    "inlineSources": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/test"]
}
