TABULARIUM_ADMIN_USER=admin
TABULARIUM_ADMIN_PASSWORD=replace-with-at-least-12-characters
COUCHDB_ADMIN_PASSWORD=replace-with-a-separate-random-password
COUCHDB_SYNC_PASSWORD=replace-with-another-random-password
TABULARIUM_PORT=3000
# Days to keep management audit records.
TABULARIUM_AUDIT_DAYS=365
TABULARIUM_ORIGINS=app://obsidian.md,capacitor://localhost,http://localhost
# External HTTPS address used by browsers; separate several entrances (LAN and public) with commas.
TABULARIUM_PUBLIC_URL=
# Outgoing mail for Send to Kindle; leave TABULARIUM_SMTP_HOST empty to disable.
# Security: tls (default port 465), starttls (587) or none (25). FROM must be on the Kindle approved-sender list.
TABULARIUM_SMTP_HOST=
TABULARIUM_SMTP_PORT=
TABULARIUM_SMTP_SECURITY=tls
TABULARIUM_SMTP_USER=
TABULARIUM_SMTP_PASSWORD=
TABULARIUM_SMTP_FROM=
# Allowed Kindle address domains (default kindle.com,free.kindle.com) and deliveries per user per day (default 30).
TABULARIUM_KINDLE_DOMAINS=
TABULARIUM_KINDLE_DAILY=
# Tabularius, the AI curator; leave TABULARIUS_PROVIDER empty to disable. Provider: anthropic or openai.
# TABULARIUS_MODEL defaults to claude-opus-5-5 for anthropic and is required for openai.
# TABULARIUS_SECRET_KEY encrypts the stored vault passphrases: openssl rand -base64 32. Keep it with this file;
# a backup restored without it cannot open those passphrases.
TABULARIUS_PROVIDER=
TABULARIUS_MODEL=
TABULARIUS_SECRET_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Semantic search through an OpenAI-compatible embeddings endpoint (OpenAI by default, or a local service); empty for full-text only.
TABULARIUS_EMBEDDING_MODEL=
TABULARIUS_EMBEDDING_URL=
TABULARIUS_EMBEDDING_KEY=
# Texts per embeddings request (default 64); lower it for a local service with little memory.
TABULARIUS_EMBEDDING_BATCH=
# Optional local knowledge base: RAGFlow's MCP endpoint and the dataset IDs Tabularius may search, comma-separated.
TABULARIUS_RAGFLOW_MCP_URL=
TABULARIUS_RAGFLOW_DATASETS=
